<?xml version="1.0" ?>
<robot name="isaac_roomba">

  <!-- ================================================================= -->
  <!-- MATERIALS (For Isaac Gym Visualizer)                              -->
  <!-- ================================================================= -->
  <material name="chassis_color">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="wheel_color">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="caster_color">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>

  <!-- ================================================================= -->
  <!-- BASE CHASSIS (The Disc)                                           -->
  <!-- ================================================================= -->
  <!-- 
    Y is UP, X is FORWARD, Z is RIGHT.
    A standard URDF cylinder aligns with Z. We rotate it 90 deg (1.5708 rad) 
    around X so the flat disc faces point UP and DOWN along the Y-axis. 
  -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.17" length="0.08"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.17" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="2.0"/>
      <!-- Ixx, Iyy, Izz updated for r=0.17m, h=0.08m, m=2.0kg -->
      <inertia ixx="0.01552" ixy="0.0" ixz="0.0" iyy="0.02890" iyz="0.0" izz="0.01552"/>
    </inertial>
  </link>

  <!-- ================================================================= -->
  <!-- FRONT DIRECTION MARKER                                            -->
  <!-- ================================================================= -->
  <material name="marker_color">
    <color rgba="1.0 0.0 0.0 1.0"/> <!-- Bright Red -->
  </material>

  <link name="front_marker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="marker_color"/>
    </visual>
  </link>

  <joint name="front_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_marker"/>
    <!-- Positioned near the front (+X) edge, sitting just on top (+Y) of the 0.08m chassis -->
    <origin xyz="0.175 0.02 0" rpy="0 0 0"/>
  </joint>


  <!-- ================================================================= -->
  <!-- Camera/LiDAR sensor                                               -->
  <!-- ================================================================= -->
  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0.15 0" rpy="0 0 0"/> <!-- Sitting on top of the Roomba -->
  </joint>

  <!-- ================================================================= -->
  <!-- LEFT DRIVE WHEEL                                                  -->
  <!-- ================================================================= -->
  <!-- 
    Cylinder aligned with Z (default), so it rolls forward along X.
  -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.015"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <!-- Ixx, Iyy, Izz updated for r=0.036m, h=0.015m, m=0.2kg -->
      <inertia ixx="0.000069" ixy="0.0" ixz="0.0" iyy="0.000069" iyz="0.0" izz="0.000130"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 -0.024 -0.1175" rpy="0 0 0"/>
    <!-- Rotates around the Z axis -->
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ================================================================= -->
  <!-- RIGHT DRIVE WHEEL                                                 -->
  <!-- ================================================================= -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.015"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000069" ixy="0.0" ixz="0.0" iyy="0.000069" iyz="0.0" izz="0.000130"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <!-- Positioned right (-Z = -0.1175m for 0.235m track baseline), Y = -0.024m to maintain ground touch -->
    <origin xyz="0 -0.024 0.1175" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ================================================================= -->
  <!-- FRONT CASTER (Frictionless Sphere)                                -->
  <!-- ================================================================= -->
  <link name="front_caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="caster_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000008" ixy="0.0" ixz="0.0" iyy="0.000008" iyz="0.0" izz="0.000008"/>
    </inertial>
  </link>

  <!-- Fixed joint because the sphere slides frictionlessly in Isaac Gym -->
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <!-- Positioned forward (+X), pulled back slightly to fit within 0.17m radius -->
    <origin xyz="0.13 -0.04 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================= -->
  <!-- REAR CASTER (Frictionless Sphere)                                 -->
  <!-- ================================================================= -->
  <link name="rear_caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="caster_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000008" ixy="0.0" ixz="0.0" iyy="0.000008" iyz="0.0" izz="0.000008"/>
    </inertial>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <!-- Positioned backward (-X), pulled in slightly to fit within 0.17m radius -->
    <origin xyz="-0.13 -0.04 0" rpy="0 0 0"/>
  </joint>

</robot>